---
layout: layouts/index.njk
eyebrow: Vocabulary
title: Vocabulary
lede: Terms that come up across the fabric, ops, rack, facility and cooling paths, each linked back to the path it belongs to.
---
{% for row in site.vocabulary %}
<div class="row" id="{{ row.id }}">
  <div class="row-head">
    <h2>{{ row.name }}</h2>
  </div>
  <p>{{ row.definition }}</p>
  {% set rel = links[row.id] %}
  {% if rel and rel.length %}
  <div class="links">
    {% for r in rel %}
    <div><b><a href="{{ r.url }}">{{ r.name }}</a></b>{% if r.reason %}<span>{{ r.reason }}</span>{% endif %}</div>
    {% endfor %}
  </div>
  {% endif %}
  {% set source = row.source %}
  {% set checked = row.checked %}
  {% set confidence = row.confidence %}
  {% set note = row.note %}
  {% include "partials/source-line.njk" %}
</div>
{% endfor %}
